# Copy to .env (optional) - every value below already has the same default in src/config.py.
# The USGS API is public and needs no API key.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=usgs-earthquakes
KAFKA_GROUP_ID=earthquake-pipeline-consumer
USGS_START_TIME=2026-10-01
USGS_END_TIME=2026-11-01
USGS_MIN_MAGNITUDE=2.5
